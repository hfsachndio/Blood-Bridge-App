rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users ────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if request.auth != null;
      // Allow any auth user to write their own doc; also allow updating fcmToken
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Donations ────────────────────────────────────────────────────────────
    match /donations/{donationId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      // Allow any auth user to update (needed for contactApprovedFor & contactRequests fields)
      allow update: if request.auth != null;
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.uid;
    }

    // ── SOS / Urgent Requests ─────────────────────────────────────────────────
    match /requests/{requestId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null
        && request.auth.uid == resource.data.uid;
    }

    // ── Chats (real-time subcollection model) ─────────────────────────────────
    match /chats/{chatId} {
      allow read, write: if request.auth != null
        && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participants;

      match /messages/{messageId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if request.auth != null;
      }
    }

    // ── Notifications (per-user feed) ─────────────────────────────────────────
    // /notifications/{userId}/items/{itemId}
    match /notifications/{userId}/items/{itemId} {
      // Owner can read their own notifications and mark as read (update)
      allow read, update, delete: if request.auth != null && request.auth.uid == userId;
      // Any authenticated user can create a notification in another user's feed
      // (required for SOS broadcast, message notify, contact request notify)
      allow create: if request.auth != null;
    }
  }
}
